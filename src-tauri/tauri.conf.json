{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SingboxGUIV0",
  "version": "0.1.0",
  "identifier": "com.antigravity.singboxguiv0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SingboxGUI V0 — Sing-box 1.14.4 Chain Proxy & Surge 5.10 Bridge",
        "width": 1360,
        "height": 880,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
